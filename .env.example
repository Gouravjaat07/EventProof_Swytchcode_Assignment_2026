# EventProof Phase 1 — example environment. Copy to `.env` and adjust.
# NEVER commit `.env` (it is gitignored). No secrets are required for Phase 1:
# provider credentials live in Swytchcode's own store (~/.swytchcode), never here.

# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Authoritative calendar (Google Calendar id; "primary" = the connected account's main calendar)
CALENDAR_ID=primary

# Swytchcode: explicit CLI binary (optional — the SDK resolves PATH/node_modules otherwise)
# SWYTCHCODE_BIN=D:\Downloads\SwtychCode_Assignment\tools\cli\node_modules\.bin\swytchcode.cmd
# Swytchcode project dir holding .swytchcode/tooling.json (default: process cwd)
# SWYTCHCODE_PROJECT_DIR=D:\Downloads\SwtychCode_Assignment
SWYTCHCODE_TIMEOUT_MS=15000
SWYTCHCODE_MAX_ATTEMPTS=3
SWYTCHCODE_METHOD_EVENTS=calendar.event.get
SWYTCHCODE_METHOD_EVENT=calendar.event.get1

# Verification lookup: days before/after the draft date searched for the event id
VERIFY_SEARCH_WINDOW_DAYS=3

# Events listing caps
EVENTS_MAX_RESULTS=50
EVENTS_MAX_RANGE_DAYS=366

# CORS allowlist, comma-separated (empty = same-origin only, no CORS headers)
# CORS_ORIGINS=https://app.example.com

# Rate limiting: max requests per window per client IP
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Durable SQLite audit database (relative paths resolve from the repo root;
# ":memory:" disables durability — tests only, never production)
AUDIT_DB_PATH=data/eventproof.db
# In-memory audit retention (applies only to the test-only memory repository)
AUDIT_MAX_RECORDS=500

# Venue aliases, "alias=Canonical;...". Only these equate; everything else compares literally.
# VENUE_ALIASES=SVSU Campus=Swami Vivekanand Subharti University
